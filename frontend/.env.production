# ─────────────────────────────────────────────────────────────────────────────
# KisanPulse — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: Do NOT commit real secrets here.
# Set REACT_APP_BACKEND_URL in the Vercel dashboard:
#   Vercel → Project → Settings → Environment Variables
#
# This file provides a fallback empty value so the build won't fail if the
# var is missing. Without it, all API calls go to "undefined/api".
# ─────────────────────────────────────────────────────────────────────────────

# Replace with your FastAPI backend URL (deployed on Render / Railway / Fly.io)
# Example: https://kisanpulse-api.onrender.com
REACT_APP_BACKEND_URL=

# Bypass react-scripts preflight version checks (safe for production builds)
SKIP_PREFLIGHT_CHECK=true

# Disable source maps to reduce build time and memory on Vercel's 2-core runner
GENERATE_SOURCEMAP=false
